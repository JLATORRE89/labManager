# Application Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key
SESSION_TYPE=filesystem

# Database Configuration
DATABASE_URL=sqlite:///labmanager.db
# For PostgreSQL: postgresql://user:password@localhost/labmanager

# Proxmox Configuration
PROXMOX_HOST=https://your-proxmox-server:8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=labmanager
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_VERIFY_SSL=false

# Default Proxmox Settings
DEFAULT_NODE=pve
DEFAULT_STORAGE=local-lvm
DEFAULT_BRIDGE=vmbr0
DEFAULT_VM_PREFIX=rhcsa9-

# Redis Configuration (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Admin User (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com

# Application Settings
MAX_CONCURRENT_DEPLOYMENTS=5
VM_DEPLOYMENT_TIMEOUT=600
LAB_EXECUTION_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/labmanager/app.log
